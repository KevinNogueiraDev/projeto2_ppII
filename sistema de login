#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
 
void mostrarRegras() {
    printf("=== CRIAR SENHA ===\n");
    printf("A senha precisa ter:\n");
    printf("- 1 letra MAIÚSCULA\n");
    printf("- 1 NÚMERO\n");
    printf("- 1 SÍMBOLO (! @ # $ & * _ - .)\n\n");
}

int validarSenha(char senha[]) {
    int maiuscula = 0, numero = 0, simbolo = 0;

    for (int i = 0; senha[i] != '\0'; i++) {
        if (isupper(senha[i])){
            maiuscula = 1;
        }
        if (isdigit(senha[i])){
            numero = 1;
        }
        if (strchr("!@#$&*_-.", senha[i])){
            simbolo = 1;
        }
    }


    if (maiuscula == 0){
        printf("Falta letra maiúscula\n");
    }
    if (numero == 0){
        printf("Falta número\n");
    }
    if (simbolo == 0){
        printf("Falta símbolo\n");
    }

    if (maiuscula == 1 && numero == 1 && simbolo == 1){
        return 1;
    }else{
        return 0;
    }
}

int confirmarSenha(char senha[]) {
    char confirmacao[30];

    printf("Confirme a senha: ");
    fgets(confirmacao, 30, stdin);
    confirmacao[strcspn(confirmacao, "\n")] = '\0';

    if (strcmp(senha, confirmacao) == 0){
        return 1;
    }else{
        return 0;
    }
}


int main() {
    char senha[30];
    int valida = 0, confirmada = 0;
    mostrarRegras();
    while (confirmada == 0) {
        valida = 0;
        while (valida == 0) {
            printf("Digite a senha: ");
            fgets(senha, 30, stdin);
            senha[strcspn(senha, "\n")] = '\0';
            system("clear");
            mostrarRegras();
            valida = validarSenha(senha);
        }
        confirmada = confirmarSenha(senha);
        if (confirmada == 0){
            printf("Senhas diferentes! Crie a senha novamente.\n\n");
        }
    }

    printf("Senha cadastrada!\n");
    return 0;
}
